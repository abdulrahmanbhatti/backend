<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit</title>
  </head>
  <body>
    <h1>Edit page ! <%= chat._id %></h1>
    <p>this chat send from <%= chat.from %> to <%= chat.to %></p>
    <form method="post" action="/chats/<%= chat._id %>?_method=PUT">
      <textarea name="message" id=""><%= chat.message %></textarea>

      <button>update</button>
    </form>
  </body>
</html>
