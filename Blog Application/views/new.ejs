<%- include("partials/header") %>

<div class="form-box">
  <h2 style="margin-bottom: 1.5rem;">Write New Blog</h2>
  <form action="/blogs" method="POST">
    <div class="form-group">
      <label for="title">Blog Title</label>
      <input type="text" id="title" name="title" placeholder="e.g. Getting Started with Node.js" required>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <label for="author">Author Name</label>
        <input type="text" id="author" name="author" placeholder="Your Name" required>
      </div>

      <div class="form-group">
        <label for="category">Category</label>
        <select id="category" name="category">
          <option value="Tech">Tech</option>
          <option value="Coding">Coding</option>
          <option value="Life">Life</option>
          <option value="Career">Career</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="content">Content</label>
      <textarea id="content" name="content" rows="10" placeholder="Write your thoughts here..." required></textarea>
    </div>

    <div class="actions">
      <button type="submit" class="btn btn-primary">Publish Blog</button>
      <a href="/blogs" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include("partials/footer") %>