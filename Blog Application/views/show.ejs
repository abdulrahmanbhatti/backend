<%- include("partials/header") %>

<article class="card" style="padding: 2.5rem;">
  <div class="card-meta">
    <span class="badge"><%= blog.category %></span>
    <span>Published by <strong><%= blog.author %></strong></span>
    <span>•</span>
    <span><%= blog.createdAt %></span>
  </div>

  <h1 style="font-size: 2rem; margin: 1rem 0 1.5rem; color: #0f172a;"><%= blog.title %></h1>

  <div style="line-height: 1.8; color: #334155; font-size: 1.05rem; white-space: pre-line;">
    <%= blog.content %>
  </div>

  <div class="actions" style="margin-top: 2.5rem; border-top: 1px solid #f1f5f9; padding-top: 1.5rem;">
    <a href="/blogs/<%= blog.id %>/edit" class="btn btn-secondary">Edit Post</a>
    
    <form action="/blogs/<%= blog.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this blog?');">
      <button type="submit" class="btn btn-danger">Delete</button>
    </form>
    
    <a href="/blogs" style="margin-left: auto; color: #64748b; text-decoration: none;">&larr; Back to list</a>
  </div>
</article>

<%- include("partials/footer") %>