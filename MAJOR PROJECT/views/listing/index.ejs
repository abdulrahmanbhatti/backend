<%- layout("/layouts/boilerplate") %>

  <body>
    <h1>All Listings </h1>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
      <% for(let list of listingData){%>
        <!-- col -->
        <a href="/listings/<%= list._id %>" class="link">
          <div class="card cols">
            <img src="<%= list.image.url %>" class="card-img-top" alt="list" style="height: 20rem;">
            <div class="card-img-overlay">abcd</div>
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%=list.title %>
                </b>
                <br>
                &#8377; <%= list.price ? list.price.toLocaleString("en-IN") : "" %>
              </p>
            </div>
          </div>
        </a>

        <% }%>
    </div>





  </body>